
<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.2.0 http://maven.apache.org/xsd/assembly-2.2.0.xsd">

    <id>sqldeveloper-extension</id>
    <formats>
        <format>zip</format>
    </formats>
    <includeBaseDirectory>false</includeBaseDirectory>

    <!-- Main JAR -->
    <files>
        <file>
            <source>${project.build.directory}/${project.artifactId}.jar</source>
            <outputDirectory>.</outputDirectory>
            <destName>${project.artifactId}.jar</destName>
        </file>
    </files>

    <!-- Required SQL Developer extension files -->
    <fileSets>
        <fileSet>
            <directory>${project.basedir}</directory>
            <outputDirectory>.</outputDirectory>
            <includes>
                <include>extension.xml</include>
                <include>sqldeveloper.xml</include>
                <include>bundle.xml</include>
            </includes>
        </fileSet>

        <!-- Include any extra libraries if you have a lib folder -->
        <fileSet>
            <directory>${project.basedir}/lib</directory>
            <outputDirectory>lib</outputDirectory>
            <includes>
                <include>**/*.jar</include>
            </includes>
        </fileSet>
    </fileSets>
</assembly>
